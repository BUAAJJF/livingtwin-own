# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
wandb/
outputs/
# ultralytics validation output
runs/
# merge leftovers; several carried pre-D455 versions of a file
*.orig

# --- where things go (see results/README.md) --------------------------------
#   logs/        trainer output (rsl_rl checkpoints, tensorboard); never hand-written
#   recordings/  every deployment session (run.py --record, pc_run.py, shadow runs)
#   checkpoints/ checkpoints copied here for evaluation, export or the viewer
#   results/     the numbers: tracked JSON + README per campaign; transcripts beside them are not
logs/
recordings/
checkpoints/

# Inside results/: what a run writes that is not a number.  The JSONs, the
# manifests and the READMEs are tracked; transcripts, markers, rendered pages,
# exports and weights are not.
results/**/*.log
results/**/*.done
results/**/FAILED
results/**/*.pid
results/**/*.exit
results/**/u_telemetry.jsonl
results/**/export/
results/**/*.html
results/**/*.mp4
results/**/*.pt
results/pages/
results/ra_sim0/
# research-branch leftovers (yf/wm-ra-research) and raw per-run sweep JSONs
results/sim2real_sweep/
results/wm1_latency/
results/wm1_damping/
results/ra_hw0/
results/accept_compare/*.json
# the 2026-09-04 audit kept its transcripts as evidence
!results/audit_20260904/*.log
# segbench renders: thousands of JPEGs per pass, re-derivable from the recording
results/segbench/**/masks_*/
results/segbench/**/shape/
results/segbench/**/relief/
# depth-bench raw frame stacks, ~50 MB per capture; the JSONs beside them are tracked
hardware/depth_bench/results/**/frames.npz
hardware/depth_bench/.venv-odin1/

# --- deployment artefacts, regenerated by the commands in hardware/deploy/README.md
# exported policies and bundles (scripts/check_export.py, scripts/pc/bundle.py rebuild them)
hardware/deploy/policies/
# YOLO weights and dataset (D405 era, D455)
hardware/deploy/yolo/
hardware/deploy/yolo_d455/
# the D405 rig; rig_d455.json is tracked
hardware/deploy/rig.json
hardware/deploy/calib_poses.json
# SAM2.1 weights, pinned by hash in sam2_assets/PROVENANCE.json
hardware/deploy/sam2_assets/*.pt
# ultralytics base weights, downloaded on first use
/yolo26n.pt
/yolo26n-seg.pt

# The Fast-FoundationStereo bench vendors its own torch/TensorRT wheels and
# engines (12 GB); build_trt_engine.py reproduces them.
hardware/depth_bench/foundation_stereo_bench/_deps/
hardware/depth_bench/foundation_stereo_bench/_deps_trt/
hardware/depth_bench/foundation_stereo_bench/third_party/
hardware/depth_bench/foundation_stereo_bench/results/

# --- rendered pages and videos at the root ------------------------------------
/*.html
/*.mp4
/*.png
docs/*.mp4
