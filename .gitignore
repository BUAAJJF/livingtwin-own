__pycache__/
*.py[cod]
*.egg-info/
.venv/
logs/
outputs/
wandb/
docs/*.mp4
# WM0 sweep raw per-run JSONs are large (69 MB); the summaries, manifests,
# CSVs and figures are tracked and are what the report is generated from.
results/sim2real_sweep/s1/
results/sim2real_sweep/s2/
results/sim2real_sweep/s3/
# WM1 session logs: ~4 GB of fp16 rollout tensors.  The manifest, the
# per-file descriptions and everything derived from them are tracked.
results/wm1_latency/data/*.pt
# The equivalence and adaptation evaluation logs are mjlab's warp module
# chatter; the JSONs beside them carry every number and the provenance.
results/wm1_latency/**/*.log
# Raw evaluation JSONs are ~700 kB each and there are well over a hundred.
# scripts/wm1_digest.py slims each to the fields the analysis reads -- including
# the per-environment placement vector the bootstrap resamples -- into
# results/wm1_latency/runs/, which IS tracked, so every interval in the report
# is recomputable from what is committed.
results/wm1_latency/adapt/*__r*.json
results/wm1_latency/equivalence/*__r*.json
# Depth bench raw frame stacks: ~50 MB per capture.  Kept on disk so the
# captures can be re-reduced when the metric definitions move, but the JSONs
# and figures beside them are what the comparison is made from.
hardware/depth_bench/results/**/frames.npz
hardware/depth_bench/.venv-odin1/

# Deployment artefacts.  All of these are regenerated by the commands in
# hardware/deploy/README.md and none of them is a source of truth.
recordings/
hardware/deploy/yolo/
hardware/deploy/rig.json
hardware/deploy/calib_poses.json

# ultralytics writes its validation output here
runs/
results/wm1_damping/data/*.pt
results/wm1_damping/**/*.log
results/wm1_damping/adapt/*__r*.json

# --- artefacts that are large and are not the source of truth ---------------

# Exported deployment policies: 794 MB of weights.  scripts/check_export.py
# rebuilds any of them from a training checkpoint, and the checkpoints live on
# the training host, not here.
hardware/deploy/policies/
# The YOLO backend's trained weights, rebuilt by hardware/deploy/train_yolo.py
# from the labels under hardware/deploy/yolo_d455/dataset.
hardware/deploy/yolo_d455/
# Checkpoints converted for export.
checkpoints/

# The Fast-FoundationStereo bench vendors its own PyTorch and TensorRT wheels,
# the upstream checkouts and the built engines: 12 GB between them.  The
# scripts, the measured numbers in TENSORRT_RESULTS.md and FAST_RESULTS.md, and
# the build recipe ARE tracked; build_trt_engine.py reproduces the engines.
hardware/depth_bench/foundation_stereo_bench/_deps/
hardware/depth_bench/foundation_stereo_bench/_deps_trt/
hardware/depth_bench/foundation_stereo_bench/third_party/
hardware/depth_bench/foundation_stereo_bench/results/

# Review pages rendered from a recording, tens of megabytes of JPEG each.
# hardware/deploy/review.py regenerates them from the session.
/detail.html

# Merge leftovers.  Several of these carry the pre-D455 version of a file and
# reading one as current has already cost an afternoon.
*.orig

# Segmentation-benchmark outputs.  The per-frame JSONL, the summary JSONs and
# the scripts are tracked -- they are what the comparison is made from.  The
# rendered mask stacks (53 MB) and the side-by-side page (9 MB) are rebuilt by
# hardware/deploy/sam3_infer.py and segreport.py from the recording.
results/segbench/**/masks_*/
results/segbench/**/compare_*.html

# Rendered comparisons from scripts/show_occlusion.py.
/occlusion_compare.mp4
/occlusion_compare.png
/sightline.mp4
/sightline.png

# SAM2.1 weights: 184 MB, pinned by hash in sam2_assets/PROVENANCE.json
hardware/deploy/sam2_assets/*.pt

# SAM2.1 weights: 176 MB, pinned by hash in sam2_assets/PROVENANCE.json, which
# is tracked.  The file itself is fetched, not carried.
hardware/deploy/sam2_assets/*.pt
# Per-frame evaluation pages: 8-22 MB each of embedded JPEG.  They are the
# deliverable of a single run and are regenerated by the script that made them
# (scripts/sight_viewer.py, scripts/sim_perception_check.py --html).
results/**/*.html
results/*.html
# Raw per-run evaluation JSONs and training logs from the v8/v9 campaign; the
# READMEs and WHY.md beside them carry every number that was concluded from.
results/d455_heavy_dr/**/*.log
results/accept_compare/*.json
# segbench frame renders: ~3000 JPEGs (190 MB) per pass of shaperender.py /
# the relief variant.  Re-derivable from the recording; the JSON/JSONL beside
# them carry every number.
results/segbench/**/shape/
results/segbench/**/relief/

# ultralytics base weights, downloaded on first use
/yolo26n.pt
/yolo26n-seg.pt
